 // The guest image range is part of the executable: a zero-fill segment that the Makefile links at
 // 0x140000000 (-segaddr __GUEST). dyld maps it before any allocator runs, so nothing else can land
 // there. With ASLR on it slides elsewhere, and rt_reexec_fixed_layout() restarts without ASLR.
+//
+// iOS: an app can't re-exec itself (posix_spawn SETEXEC returns EPERM) and arm64 executables are always PIE, so a
+// linked segment slides. Instead the strip [gimage_base, +GUEST_SEGMENT_SIZE) is claimed with mmap from a very early
+// constructor, before main and before Swift/UIKit start. That wins most launches; when libmalloc's initial arena
+// already sits in the strip, rt_guest_range_busy() is called once the app can tell the user (relaunch).
+// The strip holds the exe image and the translated DLLs, which on iOS are rebased into it (the dyld shared cache
+// occupies 0x180000000-0x1f2000000 there).
 #define GUEST_SEGMENT_SIZE 0x18000000
+#if !TARGET_OS_IPHONE
 __asm__(".zerofill __GUEST,__image,_rt_guest_segment," "0x18000000" ",14");
 extern char rt_guest_segment[];
+#endif
+int rt_guest_strip_claimed(void) { return guest_reserved; }
 __attribute__((constructor(101))) static void reserve_guest_range(void) {
+#if !TARGET_OS_IPHONE
     if ((uint64_t)(uintptr_t)rt_guest_segment == gimage_base && gimage_size <= GUEST_SEGMENT_SIZE) { guest_reserved = 1; return; }
+    size_t want_size = gimage_size;
+#else
+    size_t want_size = gimage_size > GUEST_SEGMENT_SIZE ? gimage_size : GUEST_SEGMENT_SIZE;
+#endif
     void *want = (void *)(uintptr_t)gimage_base;
-    void *p = mmap(want, gimage_size, PROT_NONE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    void *p = mmap(want, want_size, PROT_NONE, MAP_PRIVATE | MAP_ANON, -1, 0);
     if (p == want) { guest_reserved = 1; return; }
-    if (p != MAP_FAILED) munmap(p, gimage_size);
+    if (p != MAP_FAILED) munmap(p, want_size);
+}
+// a translated DLL rebased into the reserved strip (iOS), mapped over the reservation
+__attribute__((unused)) static int in_guest_strip(uint64_t base, uint64_t size) {
+    return guest_reserved && base >= gimage_base + gimage_size && base + size <= gimage_base + GUEST_SEGMENT_SIZE;
 }
